# Plantilla de configuración de build. Copiar a .env si hace falta en
# local; en Cloudflare Pages la variable se pasa al comando de build.
# Ninguna dirección literal en el código (RNF-29).

# URL base de la API de PFI-Backend (sin barra final).
# VITE_API_URL=

# Fuerza el uso de los mocks de MSW en cualquiera de los dos sentidos.
# Sin la variable: mocks solo en desarrollo y solo si no hay VITE_API_URL.
#   VITE_USE_MOCKS=false  -> siempre contra la API real
#   VITE_USE_MOCKS=true   -> siempre contra los mocks
# VITE_USE_MOCKS=
