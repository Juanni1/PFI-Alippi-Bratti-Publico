# Plantilla de configuración. Copiar a .env y completar; el .env NO se
# commitea (RNF-22). Todo valor operativo va por entorno o configuración
# versionada: nada de literales en el código (RNF-29).
#
# Esqueleto: por ahora la aplicación no consume ninguna de estas variables.
# Se documentan para fijar el contrato de configuración desde el inicio.

# --- Cadena (hito del 75 %; hoy todo corre contra Hardhat local) ---
# L2_RPC_URL=
# L2_PRIVATE_KEY=          # clave del oráculo, cuenta de prueba descartable
# DIRECCION_CONTRATO_RECLAMOS=
# DIRECCION_VERIFICADOR=

# --- IPFS ---
# KUBO_API_URL=            # p. ej. http://kubo.railway.internal:5001
# PINATA_JWT=              # copia remota por subida directa (scope pinFileToIPFS)

# --- Aplicación ---
# DATABASE_URL=          # postgresql+psycopg://usuario:clave@host:5432/pfi (requerida)
# TEST_DATABASE_URL=     # postgresql+psycopg://usuario:clave@host:5432/pfi_test (tests)
# RUTA_ARTEFACTOS=         # extractor congelado, cabeza, circuito, pk, vk, SRS
# ORIGENES_PERMITIDOS=     # CORS: orígenes de la SPA separados por coma (ej. https://veredic.pages.dev,https://pfi-prototipo.pages.dev)
