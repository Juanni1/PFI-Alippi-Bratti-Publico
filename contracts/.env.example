# Plantilla de configuración para despliegue en red remota (Base Sepolia).
# Copiar a .env y completar. El .env NO se commitea (está en .gitignore);
# este .env.example sí, solo documenta el formato.
#
# Si NO se definen estas variables, todo corre en modo LOCAL sobre
# Hardhat Network, sin necesidad de .env.

# Endpoint RPC de la red de destino (Base Sepolia).
#   - Público (cero setup): https://sepolia.base.org
#   - Propio (recomendado): Alchemy/CDP, con clave propia.
L2_RPC_URL=

# Clave privada de una cuenta de PRUEBA descartable, con fondos de faucet.
# 64 hex (con o sin 0x). NUNCA usar una cuenta con fondos reales (RNF-22).
L2_PRIVATE_KEY=
